page {
  --paper: #f8f7f4;
  --surface: #ffffff;
  --text: #252824;
  --muted: #757970;
  --line: #e4e5de;
  --accent: #aa5929;
  --accent-soft: #f5e9de;
  --green: #4c7561;
  --red: #a53f36;
  --red-soft: #fbeeea;
  background: var(--paper);
  color: var(--text);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
  font-size: 28rpx;
  line-height: 1.65;
}
view,
text,
button,
input,
textarea {
  box-sizing: border-box;
}
.page {
  padding: 40rpx 36rpx calc(48rpx + env(safe-area-inset-bottom));
}
.eyebrow {
  color: var(--accent);
  font-size: 22rpx;
  font-weight: 600;
  letter-spacing: 4rpx;
}
.heading {
  font-size: 48rpx;
  font-weight: 650;
  line-height: 1.3;
  margin: 12rpx 0 20rpx;
}
.subtitle,
.muted {
  color: var(--muted);
  font-size: 25rpx;
}
.hero {
  padding: 18rpx 0 34rpx;
  border-bottom: 1rpx solid var(--line);
  margin-bottom: 32rpx;
}
.section {
  margin-top: 32rpx;
}
.section-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}
.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}
.actions {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 22rpx;
}
.actions button {
  flex: 1;
  min-width: 140rpx;
}
button {
  background: var(--surface);
  border: 1rpx solid var(--line);
  color: var(--text);
  border-radius: 16rpx;
  margin: 0;
  font-size: 27rpx;
  font-weight: 500;
  line-height: 1.4;
  padding: 24rpx 20rpx;
}
button::after {
  border: none;
}
button.primary {
  background: var(--accent);
  color: #fff;
  border-color: var(--accent);
}
button.soft {
  background: var(--accent-soft);
  color: var(--accent);
  border-color: transparent;
}
button.quiet {
  color: var(--muted);
  background: transparent;
  padding: 14rpx;
  border-color: transparent;
}
button.danger {
  color: var(--red);
}
button[disabled] {
  opacity: 0.45;
  color: var(--muted);
}
input,
textarea,
.picker {
  background: var(--surface);
  border: 1rpx solid var(--line);
  border-radius: 14rpx;
  padding: 22rpx;
  font-size: 28rpx;
  width: 100%;
}
input {
  height: 94rpx;
}
textarea {
  height: 170rpx;
  line-height: 1.6;
}
label,
.label {
  display: block;
  margin: 26rpx 0 12rpx;
  font-weight: 500;
}
.hint {
  font-size: 23rpx;
  color: var(--muted);
  margin-top: 10rpx;
}
.notice,
.error {
  border-radius: 14rpx;
  padding: 22rpx;
  margin: 20rpx 0;
  font-size: 25rpx;
}
.notice {
  background: var(--accent-soft);
  color: #75431f;
}
.error {
  background: var(--red-soft);
  color: var(--red);
}
.badge {
  display: inline-block;
  background: #e8efe8;
  color: var(--green);
  padding: 5rpx 14rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  white-space: nowrap;
}
.divider {
  height: 1rpx;
  background: var(--line);
  margin: 36rpx 0;
}
.empty {
  padding: 48rpx 18rpx;
  text-align: center;
  color: var(--muted);
}
.selectable {
  white-space: pre-wrap;
  word-break: break-word;
}
.small {
  font-size: 23rpx;
}
